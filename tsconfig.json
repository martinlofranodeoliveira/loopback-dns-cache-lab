{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "declaration": true,
    "outDir": "build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "lab/**/*.ts", "test/**/*.ts"]
}
